# Mission First — production environment.
#
# Copy to /var/www/html/mission-first/.env on the server and fill in.
# This file is read by both `next start` (via pm2) and the Prisma CLI.
# NEVER commit the filled-in version.

# Absolute path so the Prisma CLI and the running app agree regardless of cwd.
DATABASE_URL="file:/var/www/html/mission-first/prisma/prod.db"

# Session signing key. Generate a fresh one on the server:
#   openssl rand -base64 32
AUTH_SECRET=""

# Public origin, used for auth callbacks behind nginx.
AUTH_URL="https://app.gdpfirst.com"
AUTH_TRUST_HOST="true"

# Anthropic API. The app runs without this — document extraction, chat,
# insight regeneration and escalation letters will fail with a readable
# error until a funded key is present.
ANTHROPIC_API_KEY=""
AI_MODEL_HEAVY="claude-opus-5"
AI_MODEL_LIGHT="claude-haiku-4-5"

# Password for the seeded demo accounts. Change it before seeding in
# production, or skip seeding entirely.
DEMO_PASSWORD=""

NODE_ENV="production"
PORT="3010"
